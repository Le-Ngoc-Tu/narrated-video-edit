{
  "family": "camera",
  "effects": [
    {
      "id": "punch-in",
      "name": { "vi": "Zoom nhấn (punch-in)", "en": "Punch-in" },
      "aliases": ["Punch In", "Quick Zoom In", "Scale keyframe"],
      "purpose": "emphasis",
      "engine": "video",
      "about": "Phóng nhẹ khung hình vào mặt người nói trong lúc nhấn một ý, giữ nguyên tới hết cửa sổ rồi trả về. Che được chỗ cắt và làm cảnh quay một góc đỡ đơn điệu.",
      "let": { "Z": "1+{amount}*min(1,t/{rise})*min(1,({dur}-t)/{fall})" },
      "chain": "{zoomcrop}",
      "params": {
        "amount": { "default": 0.14, "min": 0.04, "max": 0.4, "unit": "x", "doc": "độ phóng thêm (0,14 là 114%)" },
        "rise": { "default": 0.12, "min": 0.04, "max": 0.6, "unit": "s", "doc": "thời gian phóng vào" },
        "fall": { "default": 0.25, "min": 0.04, "max": 0.8, "unit": "s", "doc": "thời gian thu về" }
      },
      "dur": { "min": 0.6, "default": 1.2, "max": 3 },
      "intensity": 1,
      "beat": "any",
      "faceSafe": true,
      "needs": ["faces"],
      "styles": { "hype": "use", "explainer": "use", "documentary": "sparing" },
      "perMinute": 8,
      "sfx": ["pop"],
      "pitfalls": ["phóng quá 1,25x thì ảnh 720p bị vỡ hạt", "đặt tâm sai chỗ thì mặt trôi khỏi khung: dùng tâm mặt fx, fy"]
    },
    {
      "id": "jump-punch",
      "name": { "vi": "Cắt phóng cứng (jump punch)", "en": "Hard punch-in cut" },
      "aliases": ["Punch-in cut", "Jump cut zoom", "Scale cut"],
      "purpose": "retention",
      "engine": "video",
      "about": "Phóng ngay lập tức, không chuyển động, như cắt sang ống kính gần hơn. Cách dựng phổ biến nhất để che jump cut và đổi nhịp mà không cần chuyển cảnh.",
      "let": { "Z": "1+{amount}" },
      "chain": "{zoomcrop}",
      "params": { "amount": { "default": 0.12, "min": 0.05, "max": 0.3, "unit": "x", "doc": "độ phóng thêm" } },
      "dur": { "min": 1, "default": 3, "max": 8 },
      "intensity": 1,
      "beat": "none",
      "faceSafe": true,
      "needs": ["faces"],
      "styles": { "hype": "use", "explainer": "use", "documentary": "avoid" },
      "perMinute": 6,
      "sfx": [],
      "pitfalls": ["luân phiên mức phóng 1,0 rồi 1,12 rồi 1,0 mới tạo nhịp; cùng một mức mãi thì như không có gì"]
    },
    {
      "id": "crash-zoom",
      "name": { "vi": "Crash zoom", "en": "Crash zoom" },
      "aliases": ["Snap Zoom", "Fast Zoom", "Crash Zoom (DaVinci Fusion)"],
      "purpose": "emphasis",
      "engine": "video",
      "about": "Phóng cực nhanh vào mặt rồi giữ, kèm nhoè chuyển động. Dùng cho câu chốt hoặc khoảnh khắc bất ngờ; tạo cảm giác giật mình có chủ ý.",
      "let": { "Z": "1+{amount}*(1-pow(1-min(1,t/{rise}),4))*min(1,({dur}-t)/{fall})" },
      "graph": "[in]split[a][b];[b]{zoomcrop},gblur=sigma={blur}[c];[a]{zoomcrop}[d];[d][c]blend=all_expr='A*(1-0.8*max(0,1-T/{rise}))+B*0.8*max(0,1-T/{rise})'[out]",
      "params": {
        "amount": { "default": 0.3, "min": 0.1, "max": 0.7, "unit": "x", "doc": "độ phóng thêm" },
        "rise": { "default": 0.1, "min": 0.04, "max": 0.3, "unit": "s", "doc": "thời gian lao vào" },
        "fall": { "default": 0.3, "min": 0.04, "max": 0.8, "unit": "s", "doc": "thời gian thu về" },
        "blur": { "default": 12, "min": 2, "max": 40, "unit": "px", "doc": "độ nhoè khi lao vào" }
      },
      "dur": { "min": 0.5, "default": 0.9, "max": 2 },
      "intensity": 3,
      "beat": "kick",
      "faceSafe": true,
      "needs": ["faces"],
      "styles": { "hype": "use", "explainer": "sparing", "documentary": "avoid" },
      "perMinute": 3,
      "sfx": ["whoosh", "impact"],
      "pitfalls": ["tối đa vài lần mỗi video; dùng liên tục thì mất tác dụng", "chạm cả khung hình: tính vào hạn 3 cú mạnh mỗi video"]
    },
    {
      "id": "slow-push",
      "name": { "vi": "Đẩy máy chậm (slow push)", "en": "Slow push-in" },
      "aliases": ["Dolly In", "Slow Zoom", "Ken Burns in"],
      "purpose": "mood",
      "engine": "video",
      "about": "Phóng rất chậm và đều suốt một đoạn nói để tạo cảm giác tiến lại gần, tăng căng thẳng hoặc tình cảm. Gần như không nhận ra nhưng cảnh sống hơn.",
      "let": { "Z": "1+{amount}*{eio}" },
      "chain": "{zoomcrop}",
      "params": { "amount": { "default": 0.1, "min": 0.03, "max": 0.3, "unit": "x", "doc": "tổng độ phóng" } },
      "dur": { "min": 2, "default": 5, "max": 20 },
      "intensity": 1,
      "beat": "none",
      "faceSafe": true,
      "needs": ["faces"],
      "styles": { "hype": "sparing", "explainer": "use", "documentary": "use" },
      "perMinute": 4,
      "sfx": [],
      "pitfalls": ["đoạn quá ngắn thì thấy giật cục thay vì trượt êm", "không dùng chung với punch-in cùng cửa sổ"]
    },
    {
      "id": "pull-out",
      "name": { "vi": "Lùi máy tiết lộ (pull-out)", "en": "Pull-out reveal" },
      "aliases": ["Dolly Out", "Zoom Out", "Scale down keyframe"],
      "purpose": "reveal",
      "engine": "video",
      "about": "Bắt đầu gần rồi lùi dần về khung gốc. Hợp để mở một ý mới hoặc nhả căng thẳng sau khoảnh khắc nhấn.",
      "let": { "Z": "1+{amount}*(1-{eio})" },
      "chain": "{zoomcrop}",
      "params": { "amount": { "default": 0.16, "min": 0.04, "max": 0.4, "unit": "x", "doc": "độ phóng lúc đầu" } },
      "dur": { "min": 0.6, "default": 1.4, "max": 4 },
      "intensity": 1,
      "beat": "any",
      "faceSafe": true,
      "needs": ["faces"],
      "styles": { "hype": "use", "explainer": "use", "documentary": "use" },
      "perMinute": 4,
      "sfx": [],
      "pitfalls": ["đặt ngay sau một cú crash-zoom thì thành nhịp hít thở tự nhiên"]
    },
    {
      "id": "zoom-pulse",
      "name": { "vi": "Zoom nhịp (pulse)", "en": "Beat zoom pulse" },
      "aliases": ["Beat Zoom", "Bounce Zoom", "Pulse"],
      "purpose": "rhythm",
      "engine": "video",
      "about": "Phóng lên rồi về trong một nhịp, lặp theo số lần đặt. Gắn vào tiếng kick hoặc từ nhấn để hình đập theo nhịp.",
      "let": { "Z": "1+{amount}*pow(max(0,sin(PI*{beats}*{p})),2)" },
      "chain": "{zoomcrop}",
      "params": {
        "amount": { "default": 0.06, "min": 0.02, "max": 0.2, "unit": "x", "doc": "độ phóng mỗi nhịp" },
        "beats": { "default": 2, "min": 1, "max": 8, "unit": "lần", "doc": "số nhịp trong cửa sổ" }
      },
      "dur": { "min": 0.4, "default": 1.2, "max": 6 },
      "intensity": 2,
      "beat": "kick",
      "faceSafe": true,
      "needs": ["faces"],
      "styles": { "hype": "use", "explainer": "avoid", "documentary": "avoid" },
      "perMinute": 3,
      "sfx": ["impact"],
      "pitfalls": ["mỗi nhịp là một cú chạm cả khung hình: giữ amount nhỏ và dưới vài lần mỗi video"]
    },
    {
      "id": "bounce-zoom",
      "name": { "vi": "Zoom nảy (bounce)", "en": "Bounce-in zoom" },
      "aliases": ["Elastic Zoom", "Overshoot Zoom", "Pop Zoom"],
      "purpose": "emphasis",
      "engine": "video",
      "about": "Phóng vào quá đà rồi nảy lại và lắng xuống như lò xo. Vui, trẻ trung, hợp câu đùa hoặc một từ bật.",
      "let": { "Z": "1+{amount}*(1-exp(-7*t)*cos(16*t))*min(1,({dur}-t)/0.25)" },
      "chain": "{zoomcrop}",
      "params": { "amount": { "default": 0.12, "min": 0.04, "max": 0.3, "unit": "x", "doc": "độ phóng khi lắng xuống" } },
      "dur": { "min": 0.7, "default": 1.2, "max": 2.5 },
      "intensity": 2,
      "beat": "any",
      "faceSafe": true,
      "needs": ["faces"],
      "styles": { "hype": "use", "explainer": "sparing", "documentary": "avoid" },
      "perMinute": 3,
      "sfx": ["pop"],
      "pitfalls": ["độ nảy đầu có thể vượt amount tới gần 1,6 lần: giữ amount dưới 0,2 với video 720p"]
    },
    {
      "id": "handheld",
      "name": { "vi": "Rung tay (handheld)", "en": "Handheld sway" },
      "aliases": ["Camera Shake (subtle)", "Handheld", "Organic shake"],
      "purpose": "mood",
      "engine": "video",
      "about": "Rung và trôi rất nhẹ như người cầm máy, làm cảnh tĩnh có sức sống. Chỉ vài pixel, không chủ ý bị để ý.",
      "let": { "DX": "{amp}*(sin(2.1*t)+0.6*sin(5.3*t+1))", "DY": "{amp}*0.8*(sin(1.7*t+2)+0.5*sin(4.1*t))" },
      "chain": "{shakecrop}",
      "params": {
        "amp": { "default": 6, "min": 1, "max": 24, "unit": "px", "doc": "biên độ rung" },
        "margin": { "default": 1.06, "min": 1.02, "max": 1.2, "unit": "x", "doc": "độ phóng dự phòng để không lộ mép" }
      },
      "dur": { "min": 1, "default": 4, "max": 30 },
      "intensity": 1,
      "beat": "none",
      "faceSafe": true,
      "styles": { "hype": "sparing", "explainer": "avoid", "documentary": "use" },
      "perMinute": 4,
      "sfx": [],
      "pitfalls": ["video quay tay thật đã rung sẵn: không chồng thêm", "amp trên 12px đã thành rung mạnh"]
    },
    {
      "id": "impact-shake",
      "name": { "vi": "Rung va chạm (impact shake)", "en": "Impact shake" },
      "aliases": ["Camera Shake", "Earthquake (short)", "Hit shake"],
      "purpose": "emphasis",
      "engine": "video",
      "about": "Rung mạnh rồi tắt nhanh như vừa có va đập. Đi cùng tiếng impact hoặc kick ở câu chốt hoặc cú bất ngờ.",
      "let": { "DX": "{amp}*exp(-{decay}*t)*sin(48*t)", "DY": "{amp}*0.7*exp(-{decay}*t)*cos(41*t+1)" },
      "chain": "{shakecrop}",
      "params": {
        "amp": { "default": 22, "min": 4, "max": 60, "unit": "px", "doc": "biên độ lúc đầu" },
        "decay": { "default": 7, "min": 2, "max": 20, "unit": "1/s", "doc": "độ tắt dần" },
        "margin": { "default": 1.1, "min": 1.02, "max": 1.3, "unit": "x", "doc": "độ phóng dự phòng" }
      },
      "dur": { "min": 0.3, "default": 0.7, "max": 1.5 },
      "intensity": 3,
      "beat": "kick",
      "faceSafe": true,
      "styles": { "hype": "use", "explainer": "avoid", "documentary": "avoid" },
      "perMinute": 3,
      "flash": 0,
      "sfx": ["impact"],
      "pitfalls": ["là cú chạm cả khung hình: tối đa 3 lần mỗi video", "không dùng cho người xem nhạy cảm chuyển động nếu kéo dài quá 1 giây"]
    },
    {
      "id": "rumble",
      "name": { "vi": "Rung liên tục (rumble)", "en": "Rumble shake" },
      "aliases": ["Earthquake", "Low-frequency shake"],
      "purpose": "mood",
      "engine": "video",
      "about": "Rung tần số thấp kéo dài, như tiếng trầm chạy qua cả khung. Hợp lúc tăng căng thẳng trước một cú drop hoặc khi nhắc điều đáng sợ.",
      "let": { "DX": "{amp}*{trapamp}*(sin(17*t)+sin(29*t+2))", "DY": "{amp}*{trapamp}*(cos(13*t)+sin(23*t+1))", "trapamp": "min(1,min(t/0.3,({dur}-t)/0.3))" },
      "chain": "{shakecrop}",
      "params": {
        "amp": { "default": 8, "min": 2, "max": 30, "unit": "px", "doc": "biên độ rung" },
        "margin": { "default": 1.08, "min": 1.02, "max": 1.3, "unit": "x", "doc": "độ phóng dự phòng" }
      },
      "dur": { "min": 0.8, "default": 2, "max": 6 },
      "intensity": 2,
      "beat": "none",
      "faceSafe": true,
      "styles": { "hype": "sparing", "explainer": "avoid", "documentary": "avoid" },
      "perMinute": 2,
      "sfx": ["riser"],
      "pitfalls": ["dùng kèm riser hoặc tiếng trầm thì mới thuyết phục; im lặng thì trông như lỗi máy"]
    },
    {
      "id": "dutch-tilt",
      "name": { "vi": "Nghiêng khung (dutch angle)", "en": "Dutch tilt" },
      "aliases": ["Dutch Angle", "Rotate keyframe", "Tilt"],
      "purpose": "mood",
      "engine": "video",
      "about": "Xoay nghiêng khung vài độ, kèm phóng nhẹ để không lộ góc. Gợi cảm giác bất ổn, nghi ngờ hoặc hài hước.",
      "graph": "[in]scale=trunc({W}*{margin}/2)*2:trunc({H}*{margin}/2)*2,rotate=a='{deg}*PI/180*{eio}':ow=iw:oh=ih:c=black,crop={W}:{H}[out]",
      "params": {
        "deg": { "default": 5, "min": -15, "max": 15, "unit": "độ", "doc": "góc nghiêng (âm là ngược chiều kim đồng hồ)" },
        "margin": { "default": 1.18, "min": 1.05, "max": 1.5, "unit": "x", "doc": "độ phóng để che góc" }
      },
      "dur": { "min": 0.5, "default": 1.5, "max": 5 },
      "intensity": 2,
      "beat": "none",
      "faceSafe": true,
      "styles": { "hype": "sparing", "explainer": "avoid", "documentary": "avoid" },
      "perMinute": 2,
      "sfx": [],
      "pitfalls": ["góc dưới margin tương ứng sẽ lộ viền đen ở góc: tăng margin khi tăng deg"]
    },
    {
      "id": "drift-pan",
      "name": { "vi": "Lia ngang chậm (drift pan)", "en": "Slow lateral drift" },
      "aliases": ["Pan", "Slide keyframe", "Ken Burns pan"],
      "purpose": "mood",
      "engine": "video",
      "about": "Trượt khung ngang rất chậm trên bản phóng nhẹ, tạo chuyển động cho cảnh tĩnh hoặc cảnh kể chuyện. Hướng trượt đổi được.",
      "let": { "DX": "{dir}*{travel}*({eio}-0.5)", "DY": "0" },
      "chain": "{shakecrop}",
      "params": {
        "travel": { "default": 36, "min": 8, "max": 160, "unit": "px", "doc": "quãng trượt" },
        "dir": { "default": 1, "min": -1, "max": 1, "unit": "", "doc": "1 sang phải, -1 sang trái" },
        "margin": { "default": 1.1, "min": 1.03, "max": 1.4, "unit": "x", "doc": "độ phóng dự phòng" }
      },
      "dur": { "min": 2, "default": 5, "max": 20 },
      "intensity": 1,
      "beat": "none",
      "faceSafe": true,
      "styles": { "hype": "sparing", "explainer": "use", "documentary": "use" },
      "perMinute": 4,
      "sfx": [],
      "pitfalls": ["quãng trượt phải nhỏ hơn nửa phần phóng dư ((margin-1)*W/2) để không lộ mép"]
    },
    {
      "id": "tilt-reveal",
      "name": { "vi": "Hất máy lên (tilt reveal)", "en": "Tilt-up reveal" },
      "aliases": ["Tilt Up", "Vertical slide", "Reveal tilt"],
      "purpose": "reveal",
      "engine": "video",
      "about": "Khung trượt dọc từ dưới lên vào đúng vị trí, như hất máy lên để lộ người nói. Mở đầu ý mới có chút kịch tính.",
      "let": { "DX": "0", "DY": "{travel}*(1-{eo})" },
      "chain": "{shakecrop}",
      "params": {
        "travel": { "default": 90, "min": 20, "max": 300, "unit": "px", "doc": "quãng trượt lúc đầu" },
        "margin": { "default": 1.2, "min": 1.05, "max": 1.5, "unit": "x", "doc": "độ phóng dự phòng" }
      },
      "dur": { "min": 0.4, "default": 0.8, "max": 2 },
      "intensity": 2,
      "beat": "any",
      "faceSafe": true,
      "styles": { "hype": "use", "explainer": "sparing", "documentary": "sparing" },
      "perMinute": 3,
      "sfx": ["whoosh"],
      "pitfalls": ["lệch tâm mặt khi quãng trượt lớn: kết thúc đúng vị trí cũ (travel*(1-eo) về 0)"]
    }
  ]
}
