    {
      "id": "projector-weave",
      "name": {
        "vi": "Máy chiếu phim (gate weave)",
        "en": "Projector gate weave"
      },
      "aliases": [
        "Gate Weave",
        "8mm look",
        "Film jitter"
      ],
      "purpose": "mood",
      "engine": "video",
      "about": "Khung rung nhẹ ngẫu nhiên, sáng nhấp nháy và hạt nhiễu như phim 8 ly chiếu bằng máy cũ. Thêm chất hoài niệm cho cảnh kỷ niệm.",
      "let": {
        "DX": "{amp}*(sin(n*2.7)+0.6*sin(n*5.9+1))",
        "DY": "{amp}*0.7*(sin(n*3.3+2)+0.5*sin(n*7.1))"
