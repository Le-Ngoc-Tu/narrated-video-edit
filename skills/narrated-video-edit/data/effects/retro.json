      "perMinute": 2,
      "sfx": [],
      "pitfalls": [
        "nén video mạng xã hội ăn mất hạt mịn: để amount từ 12 trở lên nếu muốn còn thấy sau khi tải lên",
        "tốn bitrate: video dài sẽ nặng hơn"
      ]
    },
    {
