      ],
      "purpose": "mood",
      "engine": "video",
      "about": "Mảng sáng cam hồng trôi qua khung như ánh sáng lọt vào máy phim. Ấm, hoài niệm, lãng mạn; hợp chuyển cảnh nhẹ và đoạn kể chuyện. Sinh bằng mã, không dùng video rò sáng bên ngoài.",
      "graph": "gradients=s={W}x{H}:r={fps}:d={durpad}:c0=0xff5a1e:c1=0xffb347:c2=0xff2d6f:nb_colors=3:speed=0.03:type=radial,trim=end_frame={frames}[lk];[in]format=gbrp[a];[lk]format=gbrp[b];[a][b]blend=all_expr='255*(1-(1-A/255)*(1-B/255*{amount}*{bellT}*(0.1+0.9*pow(clip(1.1-hypot(X-W*0.9,Y-H*0.1)/hypot(W,H),0,1),2))))'[out]",
