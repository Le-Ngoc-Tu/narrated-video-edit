      "graph": "color=c=0xff6a00:s={W}x{H}:r={fps}:d={durpad},trim=end_frame={frames}[bn];[in]format=gbrp[a];[bn]format=gbrp[b];[a][b]blend=all_expr='255*(1-(1-A/255)*(1-B/255*{amount}*pow({bellT},1.5)*clip(1.3-hypot(X-W*0.1,Y-H*0.9)/hypot(W,H)*1.1,0.25,1)))'[out]",
