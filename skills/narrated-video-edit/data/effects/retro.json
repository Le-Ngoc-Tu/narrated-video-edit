          "default": 0.025,
          "min": 0.005,
          "max": 0.08,
          "unit": "",
          "doc": "độ nhấp nháy sáng"
        },
        "margin": {
          "default": 1.05,
          "min": 1.02,
          "max": 1.2,
          "unit": "x",
          "doc": "phóng dự phòng"
        }
      },
      "dur": {
        "min": 1,
        "default": 5,
        "max": 60
      },
      "intensity": 1,
      "beat": "none",
      "faceSafe": true,
      "styles": {
