          "min": 8,
          "max": 120,
          "unit": "px",
          "doc": "độ cao dải lỗi"
        }
      },
      "dur": {
        "min": 1,
        "default": 4,
        "max": 60
      },
      "intensity": 2,
      "beat": "none",
      "faceSafe": true,
      "styles": {
