      },
      "dur": {
        "min": 1,
        "default": 6,
        "max": 120
      },
      "intensity": 1,
      "beat": "none",
      "faceSafe": true,
      "styles": {
        "hype": "sparing",
        "explainer": "avoid",
        "documentary": "use"
