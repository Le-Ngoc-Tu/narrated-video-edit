      "chain": "drawtext=fontfile='{fontBold}':text='REC':x='w*0.1':y='h*0.055':fontsize='h*0.028':fontcolor=white:shadowcolor=black@0.6:shadowx=2:shadowy=2,drawbox=x='iw*0.055':y='ih*0.058':w='ih*0.02':h='ih*0.02':color=red@0.95:t=fill:enable='lt(mod(t,1),0.6)',drawtext=fontfile='{fontBold}':text='%{pts\\:hms}':x='w*0.055':y='h*0.09':fontsize='h*0.024':fontcolor=white:shadowcolor=black@0.6:shadowx=2:shadowy=2",
