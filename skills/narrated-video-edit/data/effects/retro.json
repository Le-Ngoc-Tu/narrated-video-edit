      "graph": "[in]boxblur=1:1[v0];[v0]split[a][b];[b]chromashift=crh=30:cbh=-30,noise=alls=60:allf=t,eq=brightness=0.1[c];[a]chromashift=crh=4:cbh=-4,noise=alls=14:allf=t,eq=saturation=1.2[d];[d]format=gbrp[d2];[c]format=gbrp[c2];[d2][c2]blend=all_expr='if(between(Y,mod(T*{speed},H),mod(T*{speed},H)+{band}),B,A)'[out]",
