{
  "family": "transition",
  "effects": [
    {
      "id": "whip-pan",
      "name": { "vi": "Quét ngang (whip pan)", "en": "Whip pan" },
      "aliases": ["Whip Pan", "Swish Pan", "Slide + motion blur"],
      "purpose": "transition",
      "engine": "video",
      "about": "Khung hình quét ngang rất nhanh kèm nhoè chuyển động, đỉnh ở đúng chỗ cắt để che mối nối. Chuyển cảnh phổ biến nhất của video ngắn; đặt cửa sổ cân hai bên điểm cắt.",
      "let": { "DX": "{dir}*{travel}*{W}*if(lt({p},0.5),pow(2*{p},2),-pow(2-2*{p},2))", "DY": "0" },
      "graph": "[in]{shakecrop}[s];[s]split[a][b];[b]gblur=sigma={blur}:sigmaV=0.5[c];[a][c]blend=all_expr='A*(1-{bellT})+B*{bellT}'[out]",
      "params": {
        "dir": { "default": 1, "min": -1, "max": 1, "unit": "", "doc": "1 quét sang phải, -1 sang trái" },
        "travel": { "default": 0.12, "min": 0.04, "max": 0.2, "unit": "W", "doc": "quãng quét theo chiều rộng khung" },
        "blur": { "default": 28, "min": 6, "max": 60, "unit": "px", "doc": "độ nhoè ngang ở đỉnh" },
        "margin": { "default": 1.3, "min": 1.1, "max": 1.6, "unit": "x", "doc": "phóng dự phòng, phải lớn hơn 1 + 2*travel" }
      },
      "dur": { "min": 0.2, "default": 0.4, "max": 0.8 },
      "intensity": 2,
      "beat": "snare",
      "faceSafe": true,
      "styles": { "hype": "use", "explainer": "sparing", "documentary": "avoid" },
      "perMinute": 6,
      "sfx": ["whoosh"],
      "pitfalls": ["đỉnh nhoè phải trùng điểm cắt: đặt cửa sổ đối xứng quanh nó", "lạm dụng mọi chỗ cắt sẽ thành chiêu trò; chọn 1 trong 3 chỗ cắt"]
    },
    {
      "id": "whip-tilt",
      "name": { "vi": "Quét dọc (whip tilt)", "en": "Vertical whip" },
      "aliases": ["Whip Tilt", "Vertical slide + blur"],
      "purpose": "transition",
      "engine": "video",
      "about": "Quét dọc nhanh có nhoè, đỉnh ở điểm cắt. Hợp video dọc 9:16 vì vuốt lên là cử chỉ quen thuộc của người xem.",
      "let": { "DX": "0", "DY": "{dir}*{travel}*{H}*if(lt({p},0.5),pow(2*{p},2),-pow(2-2*{p},2))" },
      "graph": "[in]{shakecrop}[s];[s]split[a][b];[b]gblur=sigma=0.5:sigmaV={blur}[c];[a][c]blend=all_expr='A*(1-{bellT})+B*{bellT}'[out]",
      "params": {
        "dir": { "default": 1, "min": -1, "max": 1, "unit": "", "doc": "1 quét xuống, -1 quét lên" },
        "travel": { "default": 0.1, "min": 0.04, "max": 0.2, "unit": "H", "doc": "quãng quét theo chiều cao khung" },
        "blur": { "default": 28, "min": 6, "max": 60, "unit": "px", "doc": "độ nhoè dọc ở đỉnh" },
        "margin": { "default": 1.25, "min": 1.1, "max": 1.6, "unit": "x", "doc": "phóng dự phòng, phải lớn hơn 1 + 2*travel" }
      },
      "dur": { "min": 0.2, "default": 0.4, "max": 0.8 },
      "intensity": 2,
      "beat": "snare",
      "faceSafe": true,
      "styles": { "hype": "use", "explainer": "sparing", "documentary": "avoid" },
      "perMinute": 5,
      "sfx": ["whoosh"],
      "pitfalls": ["đổi chiều quét giữa các lần dùng (xen lên, xuống) để khỏi lặp"]
    },
    {
      "id": "zoom-blur-through",
      "name": { "vi": "Lao qua zoom nhoè", "en": "Zoom-through blur" },
      "aliases": ["Zoom Transition", "Radial zoom", "Zoom In transition"],
      "purpose": "transition",
      "engine": "video",
      "about": "Khung lao vào rất nhanh và nhoè ở điểm cắt rồi trở lại bình thường ở cảnh sau, như xuyên qua máy quay. Mạnh hơn whip pan, hợp lúc đổi ý lớn.",
      "let": { "Z": "1+{amount}*pow(sin(PI*{p}),2)" },
      "graph": "[in]{zoomcrop}[s];[s]split[a][b];[b]gblur=sigma={blur}[c];[a][c]blend=all_expr='A*(1-{bellT})+B*{bellT}'[out]",
      "params": {
        "amount": { "default": 0.5, "min": 0.15, "max": 1, "unit": "x", "doc": "độ phóng ở đỉnh" },
        "blur": { "default": 20, "min": 4, "max": 50, "unit": "px", "doc": "độ nhoè ở đỉnh" }
      },
      "dur": { "min": 0.25, "default": 0.5, "max": 1 },
      "intensity": 3,
      "beat": "kick",
      "faceSafe": true,
      "needs": ["faces"],
      "styles": { "hype": "use", "explainer": "avoid", "documentary": "avoid" },
      "perMinute": 3,
      "sfx": ["whoosh", "impact"],
      "pitfalls": ["là cú chạm cả khung hình: tính vào hạn 3 cú mạnh mỗi video", "video 720p phóng trên 1,6x sẽ vỡ hạt, nhưng ở đỉnh đã nhoè nên ít lộ"]
    },
    {
      "id": "roll-swing",
      "name": { "vi": "Lắc xoay (roll swing)", "en": "Roll swing" },
      "aliases": ["Spin Transition", "Rotate whip", "Roll"],
      "purpose": "transition",
      "engine": "video",
      "about": "Khung xoay nghiêng sang một bên rồi trả lại qua điểm cắt, tự phóng vừa đủ để không lộ góc đen. Vui và có năng lượng; hợp nhịp nhạc.",
      "let": { "A": "{deg}*PI/180*sin(2*PI*{p})", "Z": "cos({A})+max({H}/{W},{W}/{H})*abs(sin({A}))" },
      "chain": "rotate=a='{A}':ow={W}:oh={H}:c=black,{zoomctr}",
      "params": { "deg": { "default": 14, "min": 4, "max": 35, "unit": "độ", "doc": "góc lắc tối đa" } },
      "dur": { "min": 0.3, "default": 0.6, "max": 1.2 },
      "intensity": 2,
      "beat": "snare",
      "faceSafe": true,
      "styles": { "hype": "use", "explainer": "avoid", "documentary": "avoid" },
      "perMinute": 3,
      "sfx": ["whoosh"],
      "pitfalls": ["tâm xoay là giữa khung; góc lớn kéo theo phóng lớn (30 độ cần 1,7x trên khung dọc): giữ dưới 20 độ với video 720p"]
    },
    {
      "id": "flash-white",
      "name": { "vi": "Chớp trắng (flash)", "en": "White flash cut" },
      "aliases": ["Flash Transition", "Dip to White", "Exposure flash"],
      "purpose": "transition",
      "engine": "video",
      "about": "Khung chói trắng ngắn ở điểm cắt rồi tan. Đánh dấu thay đổi lớn hoặc câu chốt; dùng tiết kiệm vì cả khung sáng đột ngột.",
      "graph": "color=c=white:s={W}x{H}:r={fps}:d={durpad},trim=end_frame={frames}[fl];[in][fl]blend=all_expr='A*(1-{K})+B*{K}'[out]",
      "let": { "K": "pow({bellT},{sharp})*{peak}" },
      "params": {
        "peak": { "default": 0.85, "min": 0.2, "max": 1, "unit": "", "doc": "độ trắng ở đỉnh (1 là trắng hẳn)" },
        "sharp": { "default": 2, "min": 1, "max": 6, "unit": "", "doc": "độ nhọn của đỉnh (lớn hơn là chớp ngắn hơn)" }
      },
      "dur": { "min": 0.15, "default": 0.3, "max": 0.6 },
      "intensity": 3,
      "beat": "kick",
      "faceSafe": true,
      "styles": { "hype": "use", "explainer": "sparing", "documentary": "avoid" },
      "perMinute": 3,
      "flash": 1,
      "sfx": ["impact"],
      "pitfalls": ["chớp trắng liên tiếp trên 3 lần mỗi giây là nguy cơ co giật nhạy sáng", "tối đa vài lần mỗi video"]
    },
    {
      "id": "dip-black",
      "blackEdges": true,
      "name": { "vi": "Tối dần rồi sáng (dip to black)", "en": "Dip to black" },
      "aliases": ["Dip to Black", "Fade through black", "Fade out/in"],
      "purpose": "transition",
      "engine": "video",
      "about": "Tối hẳn ở điểm cắt rồi sáng lại. Báo hiệu chuyển chương, hết một ý, qua thời gian; nhịp chậm và trang trọng.",
      "graph": "color=c=black:s={W}x{H}:r={fps}:d={durpad},trim=end_frame={frames}[bk];[in][bk]blend=all_expr='A*(1-{K})+B*{K}'[out]",
      "let": { "K": "pow({bellT},{sharp})" },
      "params": { "sharp": { "default": 1.5, "min": 1, "max": 5, "unit": "", "doc": "độ nhọn của đỉnh tối" } },
      "dur": { "min": 0.3, "default": 0.7, "max": 1.6 },
      "intensity": 1,
      "beat": "none",
      "faceSafe": true,
      "styles": { "hype": "sparing", "explainer": "use", "documentary": "use" },
      "perMinute": 3,
      "sfx": [],
      "pitfalls": ["đỉnh tối trùng điểm cắt; nếu lệch thì thấy cú cắt trước khi tối"]
    },
    {
      "id": "flash-color",
      "name": { "vi": "Chớp màu", "en": "Color flash" },
      "aliases": ["Color dip", "Flash Frame", "Colored flash"],
      "purpose": "transition",
      "engine": "video",
      "about": "Như chớp trắng nhưng màu theo thương hiệu hoặc không khí (cam ấm, hồng, xanh). Cho điểm nhấn thẩm mỹ thay vì chói gắt.",
      "graph": "color=c={tint}:s={W}x{H}:r={fps}:d={durpad},trim=end_frame={frames}[fl];[in][fl]blend=all_expr='A*(1-{K})+B*{K}'[out]",
      "let": { "K": "pow({bellT},{sharp})*{peak}" },
      "params": {
        "tint": { "type": "text", "default": "orange", "doc": "tên màu ffmpeg hoặc mã 0xRRGGBB" },
        "peak": { "default": 0.7, "min": 0.2, "max": 1, "unit": "", "doc": "độ đậm ở đỉnh" },
        "sharp": { "default": 2, "min": 1, "max": 6, "unit": "", "doc": "độ nhọn của đỉnh" }
      },
      "dur": { "min": 0.15, "default": 0.35, "max": 0.7 },
      "intensity": 2,
      "beat": "any",
      "faceSafe": true,
      "styles": { "hype": "use", "explainer": "sparing", "documentary": "avoid" },
      "perMinute": 3,
      "flash": 1,
      "sfx": ["pop"],
      "pitfalls": ["màu phải trong bảng màu của video; cam và hồng hợp phong cách hype"]
    },
    {
      "id": "glitch-cut",
      "name": { "vi": "Cắt glitch (slice glitch)", "en": "Glitch cut" },
      "aliases": ["Glitch Transition", "Digital glitch", "Datamosh cut"],
      "purpose": "transition",
      "engine": "video",
      "about": "Khung vỡ thành các dải lệch ngang và tách kênh màu trong chớp mắt ở điểm cắt. Hợp nội dung công nghệ, game, phonk, hoặc ý bất ổn.",
      "graph": "[in]scale=trunc({W}*{margin}/2)*2:{H},split=4[s0][s1][s2][s3];[s0]crop={W}:'trunc({H}/4)':x='(iw-ow)/2+{amp}*{bell}*gt(sin(n*1.7+1),-0.2)*sin(n*7.3+1)':y=0[b0];[s1]crop={W}:'trunc({H}/4)':x='(iw-ow)/2+{amp}*{bell}*gt(sin(n*2.3+2),-0.2)*sin(n*5.1+2)':y='trunc({H}/4)'[b1];[s2]crop={W}:'trunc({H}/4)':x='(iw-ow)/2+{amp}*{bell}*gt(sin(n*1.3+3),-0.2)*sin(n*9.7+3)':y='trunc({H}/4)*2'[b2];[s3]crop={W}:'trunc({H}/4)':x='(iw-ow)/2+{amp}*{bell}*gt(sin(n*2.9+4),-0.2)*sin(n*6.3+4)':y='trunc({H}/4)*3'[b3];[b0][b1][b2][b3]vstack=4,scale={W}:{H},rgbashift=rh=-5:bh=5,noise=alls=18:allf=t[out]",
      "params": {
        "amp": { "default": 60, "min": 10, "max": 160, "unit": "px", "doc": "độ lệch tối đa của dải" },
        "margin": { "default": 1.3, "min": 1.1, "max": 1.6, "unit": "x", "doc": "phóng ngang dự phòng, phải lớn hơn 1 + 2*amp/W" }
      },
      "dur": { "min": 0.15, "default": 0.35, "max": 0.8 },
      "intensity": 3,
      "beat": "snare",
      "faceSafe": false,
      "styles": { "hype": "use", "explainer": "avoid", "documentary": "avoid" },
      "perMinute": 3,
      "sfx": ["glitch"],
      "pitfalls": ["các dải làm méo mặt trong chớp mắt: chỉ dùng ở điểm cắt, không kéo dài trên mặt người", "phóng ngang dự phòng làm khung hơi giãn trong cửa sổ"]
    },
    {
      "id": "pixel-dissolve",
      "name": { "vi": "Vỡ pixel", "en": "Pixelate through" },
      "aliases": ["Pixelate Transition", "Mosaic transition", "Pixelize"],
      "purpose": "transition",
      "engine": "video",
      "about": "Khung vỡ thành ô vuông lớn ở điểm cắt rồi lấy lại nét. Gợi cảm giác số hóa; hợp nội dung công nghệ hoặc retro game.",
      "graph": "[in]split[a][b];[b]pixelize=w={block}:h={block}[c];[a][c]blend=all_expr='A*(1-{bellT})+B*{bellT}'[out]",
      "params": { "block": { "default": 48, "min": 12, "max": 160, "unit": "px", "doc": "kích thước ô ở đỉnh" } },
      "dur": { "min": 0.25, "default": 0.5, "max": 1 },
      "intensity": 2,
      "beat": "any",
      "faceSafe": true,
      "styles": { "hype": "use", "explainer": "sparing", "documentary": "avoid" },
      "perMinute": 3,
      "sfx": ["glitch"],
      "pitfalls": ["ô lớn hơn 25% khung thì mất hẳn mặt: giữ block dưới W/8"]
    },
    {
      "id": "card-flip",
      "blackEdges": true,
      "name": { "vi": "Lật thẻ (flip)", "en": "Card flip" },
      "aliases": ["Flip Transition", "3D flip", "Page flip (simple)"],
      "purpose": "transition",
      "engine": "video",
      "about": "Khung co hẹp theo chiều ngang về một vạch ở điểm cắt rồi mở ra lại như lật thẻ. Rõ ràng, vui, hợp danh sách hoặc đổi mục.",
      "graph": "color=c=black:s={W}x{H}:r={fps}:d={durpad},trim=end_frame={frames}[bg];[in]scale=w='max(2,trunc({W}*abs(cos(PI*{p}))/2)*2)':h={H}:eval=frame[sq];[bg][sq]overlay=x='(W-w)/2':y=0:shortest=1[out]",
      "params": {},
      "dur": { "min": 0.3, "default": 0.5, "max": 1 },
      "intensity": 2,
      "beat": "any",
      "faceSafe": true,
      "styles": { "hype": "use", "explainer": "use", "documentary": "avoid" },
      "perMinute": 4,
      "sfx": ["whoosh"],
      "pitfalls": ["mặt bị co hẹp trong nửa giây: không dùng khi người nói đang nhấn mạnh"]
    },
    {
      "id": "iris-dip",
      "blackEdges": true,
      "name": { "vi": "Iris đóng mở", "en": "Iris close-open" },
      "aliases": ["Iris Transition", "Circle wipe dip", "Iris"],
      "purpose": "transition",
      "engine": "video",
      "about": "Một vòng tròn đen khép dần quanh khung rồi mở lại ở điểm cắt, như ống kính cổ điển. Gợi hoài niệm, phim hoạt hình, hoặc kết cảnh.",
      "graph": "color=c=black:s={W}x{H}:r={fps}:d={durpad},trim=end_frame={frames}[bk];[in]format=gbrp[a];[bk]format=gbrp[b];[a][b]blend=all_expr='A*clip((abs(cos(PI*{pT}))*1.15-hypot(X-W/2,Y-H/2)/hypot(W/2,H/2))*{soft},0,1)'[out]",
      "params": { "soft": { "default": 10, "min": 2, "max": 40, "unit": "", "doc": "độ sắc của mép vòng (lớn là sắc hơn)" } },
      "dur": { "min": 0.4, "default": 0.8, "max": 1.6 },
      "intensity": 2,
      "beat": "none",
      "faceSafe": true,
      "styles": { "hype": "sparing", "explainer": "sparing", "documentary": "sparing" },
      "perMinute": 2,
      "sfx": [],
      "pitfalls": ["tâm vòng là giữa khung, không theo mặt"]
    },
    {
      "id": "iris-color",
      "name": { "vi": "Iris một màu (chuyển chương)", "en": "Color iris chapter wipe" },
      "aliases": ["Iris wipe", "Circle wipe color", "Chapter wipe"],
      "purpose": "transition",
      "engine": "video",
      "about": "Một đĩa màu nhấn đặc phóng từ giữa lấp kín khung, giữ màu đặc một lúc rồi mở thành vòng tròn lộ cảnh sau. Dùng để mở một chương hoặc một bước mới; đặt điểm cắt vào lúc giữ màu và ở đầu một từ. Đo từ các video hướng dẫn edit: đóng khoảng 0,2 giây, giữ 0,2 đến 0,3 giây, mở 0,1 đến 0,2 giây.",
      "let": { "M": "clip((max(0,(abs(cos(PI*{pT}))-sin(PI*{hold}/2))/(1-sin(PI*{hold}/2)))*1.15-hypot(X-W/2,Y-H/2)/hypot(W/2,H/2))*{soft},0,1)" },
      "graph": "color=c={tint}:s={W}x{H}:r={fps}:d={durpad},trim=end_frame={frames}[bk];[in]format=gbrp[a];[bk]format=gbrp[b];[a][b]blend=all_expr='A*{M}+B*(1-{M})'[out]",
      "params": {
        "tint": { "type": "text", "default": "0xF2D95C", "doc": "màu nhấn của chương: tên màu ffmpeg hoặc mã 0xRRGGBB (nên lấy màu nhấn của phong cách đang dùng)" },
        "hold": { "default": 0.3, "min": 0.1, "max": 0.6, "unit": "", "doc": "phần cửa sổ giữ màu đặc (0,3 là 30% thời lượng)" },
        "soft": { "default": 10, "min": 2, "max": 40, "unit": "", "doc": "độ sắc của mép vòng (lớn là sắc hơn)" }
      },
      "dur": { "min": 0.5, "default": 0.7, "max": 1.2 },
      "intensity": 3,
      "beat": "none",
      "faceSafe": true,
      "styles": { "hype": "sparing", "explainer": "use", "documentary": "avoid" },
      "perMinute": 3,
      "sfx": ["sparkle-chime"],
      "pitfalls": ["một mảng màu sáng lấp kín khung: tối đa vài lần mỗi video, mỗi lần một chương", "tâm vòng là giữa khung, không theo mặt", "màu đặc phải khác màu chữ phụ đề đang hiện để chữ không biến mất khi đĩa đóng"]
    },
    {
      "id": "blinds-close",
      "blackEdges": true,
      "name": { "vi": "Rèm cuốn (blinds)", "en": "Venetian blinds" },
      "aliases": ["Blinds Transition", "Slice dip", "Horizontal bars"],
      "purpose": "transition",
      "engine": "video",
      "about": "Các thanh ngang đen khép lại rồi mở ra ở điểm cắt như rèm cuốn. Gọn, sạch, nhịp vừa; hợp video giải thích.",
      "graph": "color=c=black:s={W}x{H}:r={fps}:d={durpad},trim=end_frame={frames}[bk];[in]format=gbrp[a];[bk]format=gbrp[b];[a][b]blend=all_expr='if(lt(mod(Y,{bar}),{bar}*(1-abs(2*{pT}-1))),B,A)'[out]",
      "params": { "bar": { "default": 60, "min": 16, "max": 200, "unit": "px", "doc": "độ cao một thanh" } },
      "dur": { "min": 0.3, "default": 0.6, "max": 1.2 },
      "intensity": 2,
      "beat": "any",
      "faceSafe": true,
      "styles": { "hype": "sparing", "explainer": "use", "documentary": "sparing" },
      "perMinute": 3,
      "sfx": ["whoosh"],
      "pitfalls": ["thanh quá mảnh (dưới 20px) sẽ thấy răng cưa khi nén"]
    },
    {
      "id": "strobe-cut",
      "name": { "vi": "Nháy sáng gấp (strobe)", "en": "Strobe cut" },
      "aliases": ["Strobe", "Flicker transition", "Lightning flash"],
      "purpose": "transition",
