{
  "family": "time",
  "effects": [
    {
      "id": "freeze-frame",
      "name": { "vi": "Đóng băng khung (freeze frame)", "en": "Freeze frame" },
      "aliases": ["Freeze Frame", "Hold Frame", "Frame Hold"],
      "purpose": "emphasis",
      "engine": "video",
      "about": "Dừng hình ở khung đầu của cửa sổ trong lúc tiếng vẫn chạy. Hợp khoảnh khắc buồn cười, biểu cảm, hoặc để chèn chú thích lên hình dừng.",
      "chain": "trim=end_frame=1,loop=loop=-1:size=1,trim=duration={dur}",
      "params": {},
      "dur": { "min": 0.4, "default": 1, "max": 3 },
      "intensity": 2,
      "beat": "any",
      "faceSafe": true,
      "styles": { "hype": "use", "explainer": "sparing", "documentary": "sparing" },
      "perMinute": 3,
      "sfx": ["record-stop"],
      "pitfalls": ["hình dừng mà miệng vẫn có tiếng nói là cố ý hài; nếu không muốn thế, chỉ đóng băng khi người nói im", "dừng hình trên khung mờ hoặc nhắm mắt trông xấu: chọn khung đẹp làm đầu cửa sổ"]
    },
    {
      "id": "stutter-step",
      "name": { "vi": "Giật khung (stop-motion stutter)", "en": "Stutter step" },
      "aliases": ["Stop Motion", "Step time", "Frame skip"],
      "purpose": "mood",
      "engine": "video",
      "about": "Hạ tốc độ khung xuống vài hình mỗi giây để chuyển động giật như stop-motion, tiếng vẫn mượt. Cho cảm giác thủ công, nghệ thuật hoặc hài.",
      "chain": "fps={step},fps={fps}",
      "params": { "step": { "default": 8, "min": 3, "max": 15, "unit": "fps", "doc": "số hình mỗi giây giữ lại" } },
      "dur": { "min": 0.5, "default": 1.5, "max": 5 },
      "intensity": 2,
      "beat": "none",
      "faceSafe": true,
      "styles": { "hype": "use", "explainer": "avoid", "documentary": "sparing" },
      "perMinute": 2,
      "sfx": [],
      "pitfalls": ["miệng nhép mất đồng bộ với tiếng khi step dưới 6"]
    },
    {
      "id": "echo-trail",
      "name": { "vi": "Vệt mờ chuyển động (echo trail)", "en": "Echo trail" },
      "aliases": ["Echo", "Motion Trail", "Trails"],
      "purpose": "mood",
      "engine": "video",
      "about": "Các khung trước còn lưu lại mờ dần phía sau chuyển động, tạo vệt ma. Hợp cảnh mơ, kỳ ảo, chuyển động nhanh của tay hoặc máy.",
      "chain": "lagfun=decay={decay}",
      "params": { "decay": { "default": 0.92, "min": 0.7, "max": 0.98, "unit": "", "doc": "độ lưu lại (lớn là vệt dài hơn)" } },
      "dur": { "min": 0.6, "default": 2, "max": 6 },
      "intensity": 2,
      "beat": "none",
      "faceSafe": false,
      "styles": { "hype": "use", "explainer": "avoid", "documentary": "sparing" },
      "perMinute": 2,
      "sfx": [],
      "pitfalls": ["mặt nhoè thành vệt khi người nói cử động: dùng khi người nói đứng yên hoặc cho cảnh cutaway"]
    },
    {
      "id": "ghost-blend",
      "name": { "vi": "Nhòe thời gian (ghost blend)", "en": "Frame blend ghost" },
      "aliases": ["Frame Blending", "Temporal blur", "Motion smear"],
      "purpose": "mood",
      "engine": "video",
      "about": "Trộn vài khung liền nhau tạo nhoè chuyển động mềm như phơi sáng lâu. Làm cảnh nhanh trông mượt và điện ảnh hơn.",
      "chain": "tmix=frames={frames_mix}",
      "params": { "frames_mix": { "default": 5, "min": 2, "max": 12, "unit": "khung", "doc": "số khung trộn" } },
      "dur": { "min": 0.6, "default": 2, "max": 6 },
      "intensity": 1,
      "beat": "none",
      "faceSafe": true,
      "styles": { "hype": "sparing", "explainer": "avoid", "documentary": "use" },
      "perMinute": 3,
      "sfx": [],
      "pitfalls": ["giảm độ nét chữ trong cảnh: không dùng khi có chữ cần đọc"]
    },
    {
      "id": "strobe-gate",
      "name": { "vi": "Chớp đen theo nhịp (strobe gate)", "en": "Strobe gate" },
      "aliases": ["Strobe", "Stutter flash", "Shutter gate"],
      "purpose": "rhythm",
      "engine": "video",
      "about": "Tắt hình ngắn đều đặn theo nhịp, như đèn nhấp nháy. Hợp phần dồn nhịp nhạc trước drop hoặc cảnh hỗn loạn có chủ đích.",
      "let": { "G": "if(lt(mod(n,{period}),{gate}),-1,0)" },
      "chain": "eq=brightness='{G}':eval=frame",
      "params": {
        "period": { "default": 15, "min": 10, "max": 40, "unit": "khung", "doc": "chu kỳ (15 khung là 2 lần mỗi giây ở 30 fps)" },
        "gate": { "default": 2, "min": 1, "max": 6, "unit": "khung", "doc": "số khung tối trong mỗi chu kỳ" }
      },
      "dur": { "min": 0.5, "default": 1.5, "max": 4 },
      "intensity": 3,
      "beat": "any",
      "faceSafe": true,
      "styles": { "hype": "sparing", "explainer": "avoid", "documentary": "avoid" },
      "perMinute": 1,
      "flash": 2,
      "sfx": [],
      "pitfalls": ["giữ chu kỳ từ 10 khung trở lên để dưới 3 lần chớp mỗi giây (nguy cơ co giật nhạy sáng)"]
    },
    {
      "id": "slow-mo",
      "name": { "vi": "Quay chậm (slow motion)", "en": "Slow motion" },
      "aliases": ["Speed 50%", "Slow Mo", "Rate Stretch"],
      "purpose": "emphasis",
      "engine": "retime",
      "about": "Kéo dài đoạn clip bằng cách làm chậm đều, tiếng làm chậm theo. Hợp khoảnh khắc đẹp, chuyển động tay, cảnh sản phẩm. Làm cho clip dài ra nên cần nối lại mốc thời gian.",
      "video": "setpts=PTS/{speed}",
      "audio": "atempo={speed}",
      "outDur": "{dur}/{speed}",
      "params": { "speed": { "default": 0.5, "min": 0.5, "max": 0.9, "unit": "x", "doc": "tốc độ (0,5 là chậm một nửa)" } },
      "dur": { "min": 0.5, "default": 2, "max": 10 },
      "intensity": 1,
      "beat": "none",
      "faceSafe": true,
      "styles": { "hype": "use", "explainer": "sparing", "documentary": "use" },
      "perMinute": 2,
      "sfx": [],
      "pitfalls": ["video 30 fps làm chậm dưới 0,5 sẽ giật: cần nội suy khung (minterpolate) hoặc quay 60 fps", "giọng nói chậm đi nghe lạ: thay bằng nhạc hoặc tắt tiếng đoạn đó"]
    },
    {
      "id": "fast-forward",
      "name": { "vi": "Tua nhanh (fast forward)", "en": "Fast forward" },
      "aliases": ["Speed 200%", "Speed Up", "Time Lapse (light)"],
      "purpose": "rhythm",
      "engine": "retime",
      "about": "Tăng tốc đều đoạn clip, tiếng nhanh theo. Hợp đoạn lặp lại, thao tác dài, chuyển cảnh nhanh trong quá trình làm.",
      "video": "setpts=PTS/{speed}",
      "audio": "atempo={speed}",
      "outDur": "{dur}/{speed}",
      "params": { "speed": { "default": 2, "min": 1.1, "max": 2, "unit": "x", "doc": "tốc độ (2 là gấp đôi)" } },
      "dur": { "min": 0.5, "default": 4, "max": 30 },
      "intensity": 1,
      "beat": "none",
      "faceSafe": true,
      "styles": { "hype": "use", "explainer": "use", "documentary": "sparing" },
      "perMinute": 3,
      "sfx": ["whoosh"],
      "pitfalls": ["giọng nói tua nhanh trên 1,3 lần khó nghe: dùng cho đoạn không lời", "trên 2x cần xâu nhiều atempo"]
    },
    {
      "id": "reverse-play",
      "name": { "vi": "Chiếu ngược (reverse)", "en": "Reverse" },
      "aliases": ["Reverse Speed", "Rewind", "Play backwards"],
      "purpose": "humor",
      "engine": "retime",
      "about": "Phát đoạn clip ngược từ cuối về đầu, tiếng cũng ngược. Hợp hài hước, đồ vật bay về tay, hoặc hiệu ứng tua lại ngắn.",
      "video": "reverse",
      "audio": "areverse",
      "outDur": "{dur}",
      "params": {},
      "dur": { "min": 0.4, "default": 1.5, "max": 5 },
      "intensity": 2,
      "beat": "any",
      "faceSafe": true,
      "styles": { "hype": "use", "explainer": "avoid", "documentary": "avoid" },
      "perMinute": 2,
      "sfx": ["rewind"],
      "pitfalls": ["reverse nạp cả đoạn vào bộ nhớ: giữ dưới 10 giây", "giọng ngược nghe như tiếng lạ; tắt tiếng hoặc thay bằng sfx"]
    },
    {
      "id": "speed-ramp-dip",
      "name": { "vi": "Chậm gấp rồi trả (speed ramp)", "en": "Speed ramp slow dip" },
      "aliases": ["Speed Ramp", "Time Remap", "Slow-mo ramp"],
      "purpose": "emphasis",
      "engine": "retime",
      "about": "Tốc độ bình thường, hạ xuống chậm ở khoảnh khắc chính, rồi trả về bình thường. Dạng speed ramp bậc thang (không mượt); chỉ có hình, bỏ tiếng đoạn này. Hợp cú nhảy, cú vung, khoảnh khắc đỉnh.",
      "video": "setpts='(if(lt(T,{at}),T,if(lt(T,{at}+{len}),{at}+(T-{at})/{speed},T+{len}/{speed}-{len}))/TB)'",
      "outDur": "{dur}+{len}/{speed}-{len}",
      "params": {
        "at": { "default": 1, "min": 0, "max": 20, "unit": "s", "doc": "giây bắt đầu đoạn chậm (trong clip)" },
        "len": { "default": 0.8, "min": 0.2, "max": 4, "unit": "s", "doc": "độ dài đoạn chậm theo giờ gốc" },
        "speed": { "default": 0.25, "min": 0.1, "max": 0.9, "unit": "x", "doc": "tốc độ đoạn chậm" }
      },
      "dur": { "min": 2, "default": 4, "max": 20 },
      "intensity": 2,
      "beat": "kick",
      "faceSafe": true,
      "styles": { "hype": "use", "explainer": "avoid", "documentary": "sparing" },
      "perMinute": 2,
      "sfx": ["whoosh"],
      "pitfalls": ["video 30 fps chậm dưới 0,3 sẽ giật: quay 60 fps hoặc nội suy khung", "bước tốc độ đột ngột; muốn mượt hãy dựng bằng phần mềm có keyframe tốc độ"]
    },
    {
      "id": "freeze-hold-end",
      "name": { "vi": "Giữ hình cuối (hold last frame)", "en": "Hold last frame" },
      "aliases": ["Hold Last Frame", "Freeze end", "Tpad clone"],
      "purpose": "reveal",
      "engine": "retime",
      "about": "Sau khi clip hết, giữ nguyên khung cuối thêm một lúc. Cho người xem thời gian đọc chữ hoặc tiếp nhận một ý trước khi cảnh sau vào.",
      "video": "tpad=stop_mode=clone:stop_duration={hold}",
      "outDur": "{dur}+{hold}",
      "params": { "hold": { "default": 1, "min": 0.3, "max": 5, "unit": "s", "doc": "giây giữ thêm" } },
      "dur": { "min": 1, "default": 4, "max": 20 },
      "intensity": 1,
      "beat": "none",
      "faceSafe": true,
      "styles": { "hype": "sparing", "explainer": "use", "documentary": "use" },
      "perMinute": 3,
      "sfx": [],
      "pitfalls": ["tiếng phải được bù thêm khoảng im tương ứng (apad) để không lệch"]
    },
    {
      "id": "hyperlapse",
      "name": { "vi": "Tua cực nhanh (hyperlapse)", "en": "Hyperlapse" },
      "aliases": ["Time Lapse", "Hyperlapse", "Speed 800%"],
      "purpose": "rhythm",
      "engine": "retime",
      "about": "Giữ một khung trong mỗi vài khung rồi phát ở tốc độ thường, ra cảnh tua rất nhanh. Hợp quá trình dài (nấu ăn, trang điểm, di chuyển) rút gọn trong vài giây. Bỏ tiếng gốc.",
      "video": "framestep={step},setpts=N/{fps}/TB,fps={fps}",
      "outDur": "{dur}/{step}",
      "params": { "step": { "default": 8, "min": 3, "max": 30, "unit": "khung", "doc": "giữ 1 trong mỗi bao nhiêu khung" } },
      "dur": { "min": 2, "default": 4, "max": 60 },
      "intensity": 2,
      "beat": "none",
      "faceSafe": true,
      "styles": { "hype": "use", "explainer": "use", "documentary": "use" },
      "perMinute": 2,
      "sfx": ["whoosh"],
      "pitfalls": ["giữ chân máy ổn định, nếu không rung sẽ khó xem", "thêm nhạc hoặc sfx để lấp phần tiếng đã bỏ"]
    }
  ]
}
