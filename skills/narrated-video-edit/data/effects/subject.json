      "dur": {
        "min": 1,
        "default": 4,
        "max": 60
      },
      "intensity": 2,
      "beat": "none",
      "faceSafe": true,
      "needs": [
        "segmentation"
      ],
      "styles": {
        "hype": "use",
        "explainer": "sparing",
        "documentary": "avoid"
      },
      "perMinute": 1,
      "sfx": [],
