      "graph": "[in]split[a][b];[b]pixelize=w={cell}:h={cell}[bg];[bg]format=gbrp[bgx];[a]format=gbrp[ax];[mask]format=gbrp[maskx];[bgx][ax][maskx]maskedmerge[out]",
