        "Green Screen Replace",
        "Background Removal (solid)",
        "Color backdrop"
      ],
      "purpose": "brand",
      "engine": "mask",
      "about": "Cắt người ra khỏi nền và đặt lên nền một màu của thương hiệu. Nền sạch cho tiêu đề, chữ lớn, hoặc đoạn giới thiệu.",
      "graph": "color=c={tint}:s={W}x{H}:r={fps}:d={durpad},trim=end_frame={frames}[col];[col]format=gbrp[colx];[in]format=gbrp[inx];[mask]format=gbrp[maskx];[colx][inx][maskx]maskedmerge[out]",
      "params": {
        "tint": {
          "type": "text",
          "default": "0x1d2433",
          "doc": "màu nền (tên ffmpeg hoặc 0xRRGGBB)"
        }
      },
      "dur": {
        "min": 1,
        "default": 4,
        "max": 60
      },
      "intensity": 2,
      "beat": "none",
      "faceSafe": true,
      "needs": [
        "segmentation"
      ],
      "styles": {
        "hype": "use",
        "explainer": "use",
        "documentary": "sparing"
      },
      "perMinute": 1,
      "sfx": [],
      "pitfalls": [
        "viền tóc lộ nền cũ nếu mặt nạ không mịn: đặt màu nền gần tông nền gốc"
      ]
    },
    {
      "id": "bg-gradient-cutout",
      "name": {
        "vi": "Thay nền chuyển sắc",
        "en": "Gradient background"
      },
      "aliases": [
        "Gradient Backdrop",
        "Animated background",
        "Background replace (gradient)"
      ],
      "purpose": "brand",
      "engine": "mask",
      "about": "Người đặt lên nền chuyển sắc động sinh bằng mã. Hợp tiêu đề, khoảnh khắc nhấn, hoặc video tin nhanh.",
      "graph": "gradients=s={W}x{H}:r={fps}:d={durpad}:c0=0x7a2cff:c1=0xff3d81:c2=0xffb347:nb_colors=3:speed=0.02,trim=end_frame={frames}[bgc];[bgc]format=gbrp[bgcx];[in]format=gbrp[inx];[mask]format=gbrp[maskx];[bgcx][inx][maskx]maskedmerge[out]",
      "params": {},
      "dur": {
        "min": 1,
        "default": 4,
        "max": 30
      },
      "intensity": 2,
      "beat": "any",
      "faceSafe": true,
      "needs": [
        "segmentation"
      ],
      "styles": {
        "hype": "use",
        "explainer": "sparing",
        "documentary": "avoid"
      },
      "perMinute": 1,
      "sfx": [],
      "pitfalls": [
        "đổi toàn bộ không khí cảnh: không đặt giữa hai cảnh cùng nền"
      ]
    },
    {
      "id": "person-pop-scale",
      "name": {
        "vi": "Người phóng lên khỏi nền (pop out)",
        "en": "Subject pop-out scale"
      },
      "aliases": [
        "Pop Out",
        "3D Pop",
        "Subject zoom"
      ],
      "purpose": "emphasis",
      "engine": "mask",
      "about": "Người được phóng lớn nhẹ trong khi nền đứng yên, cho cảm giác bước ra khỏi màn hình. Mạnh hơn zoom thường vì nền không đổi.",
      "let": {
        "Z": "1+{amount}*{eo}"
      },
      "graph": "[in]split[a][b];[b]{zoomctr}[bz];[mask]{zoomctr}[mz];[a]format=gbrp[ax];[bz]format=gbrp[bzx];[mz]format=gbrp[mzx];[ax][bzx][mzx]maskedmerge[out]",
      "params": {
        "amount": {
          "default": 0.12,
          "min": 0.04,
          "max": 0.3,
          "unit": "x",
          "doc": "độ phóng của người"
        }
      },
      "dur": {
        "min": 0.5,
        "default": 1.2,
        "max": 5
      },
      "intensity": 2,
      "beat": "kick",
      "faceSafe": true,
      "needs": [
        "segmentation"
      ],
      "styles": {
        "hype": "use",
        "explainer": "avoid",
        "documentary": "avoid"
      },
      "perMinute": 2,
      "sfx": [
        "impact"
      ],
      "pitfalls": [
        "viền mặt nạ lộ khi phóng: giữ amount dưới 0,2",
        "tâm phóng là giữa khung, không theo mặt"
      ]
    },
    {
